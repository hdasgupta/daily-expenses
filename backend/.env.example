NODE_ENV=local
PORT=4000
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
DB_POOL_MAX=10

AWS_ENDPOINT_URL_S3=https://your-s3-endpoint.example.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-2
AWS_S3_BUCKET=expense-proofs

# Google Apps Script email HTTP API.
EMAIL_API_URL=https://script.google.com/macros/s/AKfycbwBFlwZ-xXgjGXg2_jlsek2tm4nkIHuPn9WsOl4HV1onANS3Z7PLGou76Hl-TURuDtE/exec
EMAIL_API_KEY=MyEmailApi

ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-me
OTP_TTL_MINUTES=10
OTP_EXPOSE_IN_DEV=false
DASHBOARD_CRON=30 20 * * *
DASHBOARD_TIMEZONE=Asia/Kolkata
ORGANIZATION_NAME=Rehabilitation Center
ORGANIZATION_LOGO_URL=

# Send the 7-day PDF report every day at 06:00 IST.
DAILY_EMAIL_REPORT_CRON=45 10 * * *
DAILY_EMAIL_REPORT_TIMEZONE=Asia/Kolkata
